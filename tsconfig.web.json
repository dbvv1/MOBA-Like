{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "src/client.ts",
    "src/render/**/*.ts",
    "src/input/**/*.ts",
    "src/ui/**/*.ts",
    "default-src/client.ts",
    "default-src/render/**/*.ts",
    "default-src/input/**/*.ts",
    "default-src/ui/**/*.ts"
  ],
  "exclude": [
    "tests",
    "tools"
  ]
}
